#!/bin/sh
# 提交后自动推送到 GitHub，触发 Actions 发布（方案 B：仅 toc 版本变化时实际上传 CF）
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 0
if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
  echo "[BGLite_Plus] 正在推送到 origin/$branch ..."
  git push origin "$branch" 2>&1 || echo "[BGLite_Plus] push 失败，请检查网络/凭据后手动 git push"
fi
